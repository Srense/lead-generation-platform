# Required Vite Environment Variables
VITE_SUPABASE_URL="https://your-project-url.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-api-key"

# DO NOT PUT RESEND_API_KEY HERE!
# Resend API Key belongs securely in your Supabase Dashboard Vault (Edge Function Secrets)
# Command to deploy edge secret: `npx supabase secrets set RESEND_API_KEY=re_123456789...`
